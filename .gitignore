# next.js
/.next/
/out/

# production
/build

# debug and logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
bun-debug.log*

# env files (allow a placeholder-only example if one is ever added)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# OS and editor state
.DS_Store
Thumbs.db
/.idea/
/.vscode/

